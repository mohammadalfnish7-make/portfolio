# Local Docker Compose defaults (optional — compose sets most of these)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AUTH_SECRET=local-dev-secret-change-me-please-32chars
# ADMIN_EMAIL=mhhfnesh@gmail.com
# ADMIN_PASSWORD=ChangeMeNow!123

# Copy to .env on the VPS / Coolify (runtime). Never commit .env.
# NEXT_PUBLIC_* must also be set as Coolify *build* variables.

# App
NEXT_PUBLIC_SITE_URL=https://your.domain
NODE_ENV=production

# Postgres (Coolify internal hostname, not published to host)
DATABASE_URL=postgresql://user:password@postgres:5432/portfolio?schema=public

# Auth.js
AUTH_SECRET=generate-a-long-random-string
# optional alias
NEXTAUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true

# Admin seed
ADMIN_EMAIL=mhhfnesh@gmail.com
ADMIN_PASSWORD=ChangeMeNow!123

# Email (Resend — do not SMTP from the VPS)
RESEND_API_KEY=
EMAIL_FROM=noreply@your.domain

# Analytics
ANALYTICS_DAILY_SALT=rotate-me-daily-or-keep-stable-secret

# Trusted proxies (comma-separated) when behind Traefik / Coolify
TRUSTED_PROXIES=

# Agents
AGENTS_DISABLED=false
AGENT_MONTHLY_TOKEN_BUDGET=500000
CURSOR_API_KEY=
REPO_URL=https://github.com/mohammadalfnish/portfolio
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
